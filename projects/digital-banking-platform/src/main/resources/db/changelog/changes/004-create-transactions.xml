<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="004-create-transactions" author="amir">
        <createTable tableName="transactions">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="from_account_id" type="uuid"/>
            <column name="to_account_id" type="uuid"/>
            <column name="type" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="numeric(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="varchar(255)"/>
            <column name="reference_code" type="varchar(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_tx_from_account" tableName="transactions">
            <column name="from_account_id"/>
        </createIndex>
        <createIndex indexName="idx_tx_to_account" tableName="transactions">
            <column name="to_account_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
